    Private Property mMarqueeContainer As String = ""
    Private Property mMarqueeX0 As Double
    Private Property mMarqueeY0 As Double
    Private Property mMarqueeX1 As Double
    Private Property mMarqueeY1 As Double

    ' Panning (Space-drag or middle-drag).
    Private Property mPanning As Boolean = False
    Private Property mPanOriginX As Double
    Private Property mPanOriginY As Double

    Private Property mPointerX As Double = -1.0
    Private Property mPointerY As Double = -1.0
