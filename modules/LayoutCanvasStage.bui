Import layoutcanvas.LayoutCanvasWheel
Import layoutcanvas.LayoutCanvasNative
Import editorkit
Import layoutkit.LayoutDocument
Import layoutkit.LayoutCatalog
Import layoutkit.LayoutRefactor
Import layoutkit.LayoutRelations

' Design surface: painting, hit-testing, selection gestures (click, toggle,
' marquee), move/resize with eight handles, smart guides, spacing markers,
' keyboard handling, contextual menus, placement and the viewport.

Private Class LayoutSurface Inherits LayoutWheelCanvas
    Public Property Owner As LayoutEditor
    Public Overrides Function NativeWheel(dx As Double, dy As Double, pixels As Boolean) As Boolean
        If Me.Owner = Nil Then Return False
        Return Me.Owner.StageWheel(dx, dy, pixels)
    End Function
    Handle Paint(g As Graphics)
        If Me.Owner <> Nil Then Me.Owner.PaintLayout(g)
    End Handle
    Handle MouseDown(e As MouseEvent)
        If Me.Owner = Nil Then Return
        If e.Button = MouseButton.Right Then Return
        Me.Focus()
        Me.Owner.PointerDown(e.X, e.Y, e.ClickCount, e.Modifiers.Shift, e.Modifiers.Option, e.Modifiers.Primary, e.Button = MouseButton.Middle)
        e.Handled = True
    End Handle
    Handle MouseDrag(e As MouseEvent)
        If Me.Owner <> Nil Then Me.Owner.PointerDrag(e.X, e.Y, e.Modifiers.Shift, e.Modifiers.Option, e.Modifiers.Primary)
    End Handle
    Handle MouseUp(e As MouseEvent)
        If Me.Owner = Nil Or e.Button = MouseButton.Right Then Return
        Me.Owner.PointerDrag(e.X, e.Y, e.Modifiers.Shift, e.Modifiers.Option, e.Modifiers.Primary)
        Me.Owner.PointerUp()
    End Handle
    Handle MouseMove(e As MouseEvent)
        If Me.Owner <> Nil Then Me.Owner.PointerMove(e.X, e.Y)
    End Handle
    Handle MouseExit(e As MouseEvent)
        ' No public capture API: leaving the surface safely cancels the preview.
        If Me.Owner <> Nil Then Me.Owner.PointerExited()
    End Handle
    Handle KeyDown(e As KeyEvent)
        If Me.Owner = Nil Then Return
        If Me.Owner.KeyPressed(e.Key, e.Character, e.Modifiers.Shift, e.Modifiers.Option, e.Modifiers.Primary) Then e.Handled = True
    End Handle
    Handle KeyUp(e As KeyEvent)
        If Me.Owner <> Nil Then Me.Owner.KeyReleased(e.Key)
    End Handle
    Handle ConstructContextualMenu(base As MenuItem, location As Point)
        If Me.Owner <> Nil Then Me.Owner.BuildContextMenu(base, location.X, location.Y)
    End Handle
    Handle ContextualMenuAction(hitItem As MenuItem)
        If Me.Owner <> Nil And hitItem <> Nil Then Me.Owner.ContextMenuChosen(hitItem.Tag)
    End Handle
End Class

' Arrow-key nudges accumulate into one transaction, committed on key release
' or after a short idle period.
Private Class LayoutNudgeTimer Inherits Timer
    Public Property Owner As LayoutEditor
    Public Overrides Sub NotifyTick()
        If Me.Owner <> Nil Then Me.Owner.CommitPendingNudge()
    End Sub
End Class

Public Partial Class LayoutEditor
    Private Property mSurface As LayoutSurface = New LayoutSurface()
    Private Property mNudgeTimer As LayoutNudgeTimer = New LayoutNudgeTimer()
    Private Property mZoom As Double = 1.0
    Private Property mPanX As Double = 0.0
    Private Property mPanY As Double = 0.0
    Private Property mFitPending As Boolean = False

    ' Move/resize gesture. The reference node supplies the public preview frame;
    ' every other gesture node receives the same deltas.
