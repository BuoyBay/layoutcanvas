    Private Property mLastPointerHit As String = ""
    Private Property mMoved As Boolean = False
    Private Property mRefId As String = ""
    Private Property mGestureIds As Array Of String = []
    Private Property mOrigXs As Array Of Integer = []
    Private Property mOrigYs As Array Of Integer = []
